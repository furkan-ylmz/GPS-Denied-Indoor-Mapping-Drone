<?xml version="1.0" ?>
<!--
  PX4 x500 quadrotor + sensörler (3D LiDAR, kamera, IMU).
  PX4'ün x500 modelini include edip üstüne sensör link'leri ekliyoruz.
  PX4 Gazebo plugin'leri (multirotor motor model) x500'den geliyor.
-->
<sdf version="1.9">
  <model name="x500_lidar">
    <pose>0 0 0.24 0 0 0</pose>

    <!-- ══════════════════════════════════════════════
         PX4 x500 temel drone modeli
         ══════════════════════════════════════════════ -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- ══════════════════════════════════════════════
         SENSÖR LINK: 3D LiDAR
         ══════════════════════════════════════════════ -->
    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.17</mass>
        <inertia>
          <ixx>0.00012</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00012</iyy><iyz>0</iyz>
          <izz>0.00012</izz>
        </inertia>
      </inertial>

      <!-- LiDAR gövde visual -->
      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.045</length></cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.0 0.7 1</ambient>
          <diffuse>0.0 0.0 0.9 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <collision name="lidar_collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.045</length></cylinder>
        </geometry>
      </collision>

      <!-- 3D LiDAR sensörü -->
      <sensor name="lidar_3d" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/lidar/points</topic>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>25.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <!-- LiDAR sabit ek (fixed joint) -->
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ══════════════════════════════════════════════
         SENSÖR LINK: Ön Kamera
         ══════════════════════════════════════════════ -->
    <link name="camera_link">
      <pose relative_to="base_link">0.15 0 -0.02 0 0.1 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00003</iyy><iyz>0</iyz>
          <izz>0.00003</izz>
        </inertia>
      </inertial>

      <!-- Kamera gövde visual -->
      <visual name="camera_visual">
        <geometry>
          <box><size>0.025 0.04 0.025</size></box>
        </geometry>
        <material>
          <ambient>0.0 0.5 0.0 1</ambient>
          <diffuse>0.0 0.7 0.0 1</diffuse>
        </material>
      </visual>

      <collision name="camera_collision">
        <geometry>
          <box><size>0.025 0.04 0.025</size></box>
        </geometry>
      </collision>

      <!-- Ön kamera sensörü (kapı numarası tanıma için) -->
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/camera</topic>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>50</far>
          </clip>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <!-- Kamera sabit ek -->
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

  </model>
</sdf>
