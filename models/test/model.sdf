<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="test_building">
    <static>true</static>
    <link name="building_link">
      <!--
        Blender Y-up → Gazebo Z-up: roll = +π/2
        Z offset = -2.09 (0.01 pay ile ground_plane Z=0 ile çakışma önlenir)
        Sonuç: zemin slabı Z≈0.01, tavan Z≈5.99
        Kat 1 iç yükseklik: ~2.4m (Z=0.6 → Z=3.0)
        Kat 2 iç yükseklik: ~2.3m (Z=3.1 → Z=5.4)
      -->
      <pose>0 0 -2.09 1.5708 0 0</pose>
      <collision name="building_collision">
        <geometry>
          <mesh>
            <uri>meshes/eg1.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="building_visual">
        <geometry>
          <mesh>
            <uri>meshes/eg1.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>