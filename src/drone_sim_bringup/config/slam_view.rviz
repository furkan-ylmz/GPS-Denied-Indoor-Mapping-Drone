Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /2D Map1
        - /3D Cloud Map1
        - /Odometry1
        - /Planned Path1
      Splitter Ratio: 0.55
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # ── TF ağacı: map→odom→base_link→lidar/camera ──
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.5
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Update Interval: 0

    # ── 2D Occupancy Grid Map (Nav2 uyumlu) ──
    - Class: rviz_default_plugins/Map
      Name: 2D Map
      Value: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map_clean
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Use Timestamp: false
      Update Topic:
        Value: /map_clean_updates

    # ── 3D Point Cloud Map (RTAB-Map tarafından üretilir) ──
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D Cloud Map
      Value: true
      Topic:
        Value: /cloud_map
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (Pixels): 2
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      Min Color: 0; 0; 255
      Max Color: 255; 0; 0
      Alpha: 0.8
      Decay Time: 0
      Selectable: true

    # ── Odometri (drone hareket yolu) ──
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Value: true
      Topic:
        Value: /drone/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 200
      Shape:
        Value: Arrow
        Alpha: 1.0
        Axes Length: 0.3
        Axes Radius: 0.03
        Color: 255; 255; 0
        Head Length: 0.07
        Head Radius: 0.03
        Shaft Length: 0.15
        Shaft Radius: 0.015
      Covariance:
        Value: false

    # ── Kamera görüntüsü ──
    - Class: rviz_default_plugins/Image
      Name: Camera
      Value: false
      Topic:
        Value: /drone/camera/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1.0
      Median window: 5
      Min Value: 0.0
      Normalize Range: true
      Queue Size: 2

    # ── Nav2 Planlanan Yol ──
    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Value: true
      Topic:
        Value: /drone/planned_path
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 0; 255
      Alpha: 1.0
      Buffer Length: 1
      Line Style:
        Value: Billboards
        Width: 0.05
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Style: None

    # ── Drone pozisyon marker (base_link eksen) ──
    - Class: rviz_default_plugins/Axes
      Name: Drone Axes
      Value: true
      Length: 0.5
      Radius: 0.05
      Reference Frame: base_link

  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 1.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.7854
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: TopDown
        Scale: 20
        X: 0
        Y: 0
        Angle: 0
      - Class: rviz_default_plugins/Orbit
        Name: 3D View
        Distance: 20
        Focal Point:
          X: 0
          Y: 0
          Z: 1.5
        Pitch: 0.5
        Yaw: 0.5
Window Geometry:
  Camera:
    collapsed: false
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 50
  Y: 50