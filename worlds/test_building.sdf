<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="test_building_world">

    <!-- ── Physics engine ── -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- ── Gazebo Sim plugins ── -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>

    <!-- ── SphericalCoordinates (PX4 NavSat/GPS için gerekli) ── -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- ── Scene ── -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.3 0.3 0.3 1.0</background>
      <shadows>false</shadows>
    </scene>

    <!-- ── Lighting ── -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      İç mekan aydınlatması — eg1 binası (~37m x 36m, 2 kat, ~6m yükseklik)
      Bina merkezi yaklaşık (-3, -2.5). Kat 1: Z~0-3, Kat 2: Z~3-6
      Işıklar her iki kata yayılmış, geniş attenuation range
    -->

    <!-- 
      İç mekan aydınlatmaları kaldırıldı.
    -->

    <!-- ── Ground plane ── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Test building (2 katlı kapalı alan) ── -->
    <include>
      <uri>model://test</uri>
      <name>test_building</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!--
      Drone, PX4 SITL tarafından spawn edilir.
      Manuel test için simple_drone burada bırakılabilir,
      PX4 SITL kullanılırken bu kısım otomatik atlanır.
    -->

  </world>
</sdf>
